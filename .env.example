# Ambiente alvo: demo | dev | hml | prod
TEST_ENV=demo

# URL do ambiente "demo" (padrão: https://www.saucedemo.com)
BASE_URL=https://www.saucedemo.com

# URLs dos demais ambientes (obrigatórias apenas quando TEST_ENV os selecionar)
BASE_URL_DEV=
BASE_URL_HML=
BASE_URL_PROD=

# Credenciais de teste. Para o Sauce Demo, os usuários e a senha pública
# de demonstração aparecem na própria tela de login do site.
TEST_USERNAME=
TEST_PASSWORD=
TEST_LOCKED_USERNAME=

# Timeouts em milissegundos (opcionais)
TEST_TIMEOUT=30000
EXPECT_TIMEOUT=5000
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=15000

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
